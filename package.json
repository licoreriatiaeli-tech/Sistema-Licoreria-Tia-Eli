{
  "name": "tia-eli-licoreria",
  "version": "4.0.0",
  "description": "Sistema de control de inventario y ventas para TIA ELI LICORERIA",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=chromium --grep=visual"
  },
  "keywords": [
    "inventory",
    "pos",
    "sales",
    "licoreria"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.0.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "prettier": "^3.2.5",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.20.0"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "firebase": "^10.12.0"
  },
  "build": {
    "appId": "com.tiaeli.licoreria",
    "productName": "Tia Eli Licoreria",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "**/*",
      "!dist-electron/**",
      "!tests/**",
      "!docs/**",
      "!*.py"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tia Eli Licoreria"
    }
  }
}
